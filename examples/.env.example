# Copy to examples/.env and fill in real values. Do not commit credentials.

# API root without /api/v1
PIPESHUB_BASE_URL=http://localhost:3000

# --- Authentication ---

# OAuth2 client credentials of an OAuth app with the client_credentials grant.
# The examples added for SDK 1.7.1 (see README.md) use these.
# PIPESHUB_TOKEN_URL is optional and defaults to
# ${PIPESHUB_BASE_URL}/api/v1/oauth2/token.
PIPESHUB_CLIENT_ID=
PIPESHUB_CLIENT_SECRET=
PIPESHUB_TOKEN_URL=

# The older examples read a JWT access token instead (raw token only, no
# "Bearer " prefix).
PIPESHUB_BEARER_AUTH=your-access-token

# Email and password of a user without MFA. The personal_access_tokens
# examples sign in with these, because the token endpoints accept only an
# interactive user session. The admin_* ones need an organization admin.
PIPESHUB_TEST_USER_EMAIL=user@example.com
PIPESHUB_TEST_USER_PASSWORD=your-password

# --- Example data ---

# Absolute path to a local file. The KB upload, update, move, reindex,
# delete, stream, get-record and trash examples send this file.
PIPESHUB_UPLOAD_PATH=/absolute/path/to/sample.pdf

# Model that the agent examples attach to the agents they create.
PIPESHUB_MODEL_KEY=your-model-key
PIPESHUB_MODEL_NAME=your-model-name
PIPESHUB_MODEL_PROVIDER=azureOpenAI

# Key of an existing agent. The agent_conversation examples talk to it.
AGENT_KEY=your-agent-key

# Connector instance id (UUID). The agent_conversation examples put it in
# the `apps` retrieval filter.
CONNECTOR_APP_KEY=your-connector-app-key

# Display name of a connector. KB/record_groups/reindex_record_group.py
# reindexes its first record group. Quote values that contain spaces.
PIPESHUB_CONNECTOR_NAME="BBC News RSS"

# Optional. The feed connectors/rss_connector.py syncs (default Hacker News).
PIPESHUB_RSS_FEED_URL=

# connectors/gmail_workspace_connector.py and drive_workspace_connector.py:
# a Google service account key file with domain-wide delegation, the Workspace
# admin email, and optionally the drive to sync and the search queries.
PIPESHUB_GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
PIPESHUB_GOOGLE_ADMIN_EMAIL=
PIPESHUB_GOOGLE_DRIVE_ID=
PIPESHUB_GMAIL_SEARCH_QUERY=
PIPESHUB_DRIVE_SEARCH_QUERY=

# connectors/confluence_connector.py and jira_connector.py: an Atlassian
# API token (https://id.atlassian.com/manage-profile/security/api-tokens),
# and optionally the space or project to sync and the search queries.
PIPESHUB_ATLASSIAN_BASE_URL=https://yourcompany.atlassian.net
PIPESHUB_ATLASSIAN_EMAIL=
PIPESHUB_ATLASSIAN_API_TOKEN=
PIPESHUB_CONFLUENCE_SPACE_KEY=
PIPESHUB_JIRA_PROJECT_KEY=
PIPESHUB_CONFLUENCE_SEARCH_QUERY=
PIPESHUB_JIRA_SEARCH_QUERY=

# connectors/s3_connector.py: an access key that can list and read the bucket,
# and optionally the bucket to sync and the search query.
PIPESHUB_S3_ACCESS_KEY=
PIPESHUB_S3_SECRET_KEY=
PIPESHUB_S3_BUCKET=
PIPESHUB_S3_SEARCH_QUERY=

# connectors/azure_files_connector.py: the storage account connection string
# (quote it), and optionally the one file share to sync and the search query.
PIPESHUB_AZURE_FILES_CONNECTION_STRING=
PIPESHUB_AZURE_FILES_SHARE=
PIPESHUB_AZURE_FILES_SEARCH_QUERY=

# connectors/slack_workspace_connector.py: a Slack bot token (xoxb-...), and
# optionally the one channel to sync and the search query.
PIPESHUB_SLACK_BOT_TOKEN=
PIPESHUB_SLACK_CHANNEL_ID=
PIPESHUB_SLACK_SEARCH_QUERY=
