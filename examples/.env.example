# Copy this file to a local .env (e.g. examples/.env) and fill in real values.
# Do not commit credentials.

# Required — workspace user used for password authentication
PIPESHUB_TEST_USER_EMAIL=you@example.com
PIPESHUB_TEST_USER_PASSWORD=your-password

# Optional — API root without /api/v1 (default: http://localhost:3000)
PIPESHUB_BASE_URL=http://localhost:3000

# Optional — agent to run conversation examples against
# Defaults to the value in examples/agent_conversation/helpers.py if unset
PIPESHUB_AGENT_KEY=52b7e901-f3e9-4009-bcd7-c0274c58f296

# Optional — connector used in default retrieval filters
# Defaults to the value in examples/agent_conversation/helpers.py if unset
CONNECTOR_ID=270d4bac-234a-4c0d-963f-84f152cd21f0

# Optional — only needed when calling create_agent_with_web_search() in helpers.py
# PIPESHUB_AGENT_MODEL_KEY=
